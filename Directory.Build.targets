<Project>
  <!--
    Unity-generated `Assembly-CSharp*.csproj` often only sets `DefineConstants` for the Debug
    configuration. A plain `dotnet build -c Release` then runs without `UNITY_EDITOR` / `UNITY_*`
    defines and can fail compilation.

    Fix strategy:
    - Use the Unity-generated Debug `DefineConstants` from the current `.csproj` as the source of truth.
    - Apply it to Release builds, removing `DEBUG` and ensuring `RELEASE` exists.

    This avoids hardcoding Unity version/platform symbols and preserves the full Unity-generated define set.
  -->

  <Target
    Name="CodexUnityPropagateDebugDefineConstantsToRelease"
    BeforeTargets="CoreCompile"
    Condition="'$(Configuration)' == 'Release'">

    <XmlPeek
      XmlInputPath="$(MSBuildProjectFullPath)"
      Query="/Project/PropertyGroup[contains(@Condition, &quot;== 'Debug|&quot;)]/DefineConstants/text()">
      <Output TaskParameter="Result" PropertyName="_CodexUnityDebugDefineConstantsRaw" />
    </XmlPeek>

    <PropertyGroup Condition="'$(_CodexUnityDebugDefineConstantsRaw)' != ''">
      <_CodexUnityDebugDefineConstantsUnescaped>$([MSBuild]::Unescape('$(_CodexUnityDebugDefineConstantsRaw)'))</_CodexUnityDebugDefineConstantsUnescaped>
      <_CodexUnityDebugDefineConstants>$([System.String]::Copy('$(_CodexUnityDebugDefineConstantsUnescaped)').Trim())</_CodexUnityDebugDefineConstants>
      <_CodexUnityGeneratedDefinesDetected Condition="$(_CodexUnityDebugDefineConstants.Contains('UNITY_'))">true</_CodexUnityGeneratedDefinesDetected>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_CodexUnityGeneratedDefinesDetected)' == 'true' and '$(_CodexUnityDebugDefineConstants)' != ''">
      <_CodexUnityReleaseDefineConstants>$(DefineConstants);$(_CodexUnityDebugDefineConstants)</_CodexUnityReleaseDefineConstants>
      <_CodexUnityReleaseDefineConstants>$([System.Text.RegularExpressions.Regex]::Replace('$(_CodexUnityReleaseDefineConstants)', '(^|;)DEBUG(;|$)', '$1'))</_CodexUnityReleaseDefineConstants>
      <_CodexUnityReleaseDefineConstants>$([System.Text.RegularExpressions.Regex]::Replace('$(_CodexUnityReleaseDefineConstants)', ';{2,}', ';'))</_CodexUnityReleaseDefineConstants>
      <_CodexUnityReleaseDefineConstants>$([System.String]::Copy('$(_CodexUnityReleaseDefineConstants)').Trim(';'))</_CodexUnityReleaseDefineConstants>
      <_CodexUnityReleaseDefineConstantsWrapped>;$(_CodexUnityReleaseDefineConstants);</_CodexUnityReleaseDefineConstantsWrapped>
      <_CodexUnityReleaseDefineConstants Condition="!$(_CodexUnityReleaseDefineConstantsWrapped.Contains(';RELEASE;'))">$(_CodexUnityReleaseDefineConstants);RELEASE</_CodexUnityReleaseDefineConstants>
      <DefineConstants>$(_CodexUnityReleaseDefineConstants)</DefineConstants>
    </PropertyGroup>
  </Target>
</Project>
