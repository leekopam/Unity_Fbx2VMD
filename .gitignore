# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.DS_Store
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Unity/MCP capture outputs are QA artifacts.
# Keep screenshots/videos under Docs/Workflow/Local instead.
/[Ss]creenshots/
/[Cc]aptures/
/[Vv]ideos/
/TestResults-*.log
/TestResults-*.xml
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta
/[Aa]ssets/[Cc]aptures/
/[Aa]ssets/[Cc]aptures.meta
/[Aa]ssets/[Rr]ecordings/
/[Aa]ssets/[Rr]ecordings.meta
/[Aa]ssets/[Vv]ideos/
/[Aa]ssets/[Vv]ideos.meta

# graphify generated knowledge graph outputs are local-only.
/graphify-out/
/.graphify_*

# Local-only reference packs and temporary workspaces.
/tmp/
# Windows reserved device name; bash `> nul` redirects create a real file that breaks clones.
/nul
# Keep all project Docs folders local-only.
/[Dd][Oo][Cc][Ss]/
# Agent-generated issue/report drafts must live under Docs and stay out of Git.
/.scratch/
/[Ss]cratch/
/[Ii]ssues/
/[Rr]eport/
/[Rr]eports/
/[Pp][Rr][Dd]/
/*[Ii]ssue*.[Mm][Dd]
/*[Rr]eport*.[Mm][Dd]
/*[Pp][Rr][Dd]*.[Mm][Dd]
/*[Ww][Oo][Rr][Kk][Pp][Ll][Aa][Nn]*.[Mm][Dd]
/Docs/ref/
/Assets/GUIPack-Clean&Minimalist/
/Assets/GUIPack-Clean&Minimalist.meta
/Assets/UI/GUIPack-Clean&Minimalist/
/Assets/UI/GUIPack-Clean&Minimalist.meta
/Assets/_Project/UI/GUIPack-Clean&Minimalist/
/Assets/_Project/UI/GUIPack-Clean&Minimalist.meta
/Assets/MagicaCloth2/
/Assets/MagicaCloth2.meta
/Assets/_Project/Plugins/MagicaCloth2/
/Assets/_Project/Plugins/MagicaCloth2.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
/Builds/
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# FBX 파일은 업로드 되지 않도록 설정
*.fbx
*.FBX
*.[fF][bB][xX].meta
Assets/_Project/FBX/
Assets/_Project/FBX.meta
Assets/Resources/Import_FBX/
Assets/Resources/Import_FBX.meta

# CI 성능 테스트용 소형 FBX 픽스처만 예외로 추적한다.
!Assets/_Project/Tests/PerfFixtures/
!Assets/_Project/Tests/PerfFixtures/**

# 음원 소스는 절대 업로드하지 않는다 (분리 결과물·원본·샘플 포함).
*.wav
*.wav.meta
*.mp3
*.mp3.meta
*.ogg
*.ogg.meta
*.aif
*.aif.meta
*.aiff
*.aiff.meta
*.flac
*.flac.meta
*.m4a
*.m4a.meta

# 캐릭터 모델 데이터(MMD/VRM 등)는 업로드하지 않는다.
*.pmx
*.pmx.meta
*.pmd
*.pmd.meta

# 음원 분리 도구가 내려받는 모델 가중치/캐시는 업로드하지 않는다.
*.ckpt
*.ckpt.meta
*.pt
*.pt.meta
*.onnx
*.onnx.meta
*.th
*.th.meta

# 립싱크 등 파이프라인 생성 산출물(보컬 스템, 베이크 클립)은 로컬 전용.
/Assets/Generated/
/Assets/Generated.meta

# 유료/재배포 불가 에셋과 캐릭터 레퍼런스는 Git 추적 대상이 아니다.
/Assets/Plugins/RootMotion/
/Assets/Plugins/RootMotion.meta
/Assets/MMD4Mecanim/
/Assets/MMD4Mecanim.meta
/Assets/Plugins/VMDRecorderSample/
/Assets/Plugins/VMDRecorderSample.meta
/Assets/VMDRecorderSample.meta
/Assets/_ManualReference/
/Assets/_ManualReference.meta
/Assets/_Project/Model/
/Assets/_Project/Model.meta
# 캐릭터 모델에서 생성된 클로스 프리빌드 데이터도 캐릭터 정보이므로 제외.
/Assets/_Project/Physics/PreBuild/
/Assets/_Project/Physics/PreBuild.meta

# uLipSync 임베디드 패키지의 샘플(유니티짱 에셋·보이스 음원)은 업로드하지 않는다.
# 에디터 종료 후 Samples → Samples~ 로 이름을 바꾸면 Unity가 임포트하지 않는다.
/Packages/com.hecomi.ulipsync/Samples/
/Packages/com.hecomi.ulipsync/Samples.meta

# JetBrains Rider/IDEA 설정
/.idea/

# Python 로컬 환경(venv)은 업로드하지 않는다.
**/.venv/
**/venv/
**/venv.meta

# MMD4Mecanim iOS binary ignore
Assets/MMD4Mecanim/Plugins/MMD4MecanimBulletPhysics/iOS/libBulletPhysics.a

# MCP for Unity Package
/Library/MCPForUnity/
/ProjectSettings/McpUnitySettings.json

# Local editor assistants and Unity MCP connection logs
/.serena/
/Assets/UnityMCP/
/Assets/UnityMCP.meta

# FBX Exporter stores a machine-specific integration path here.
/ProjectSettings/FbxExportSettings.asset

# 일반 Unity source/test의 companion .meta는 source와 함께 추적한다.

/Memo/

# Local tool dependency caches
/Tools/**/node_modules/
/Assets/_Project/Tools/**/node_modules/
/Assets/_Project/Tools/**/node_modules.meta

